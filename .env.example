# ─────────────────────────────────────────────────────────────
# Quantum Randomness Lab — environment configuration
# Copy to  app/backend/.env  (or the repo root .env) and fill in.
# NEVER commit the real .env. Credentials stay server-side only.
# ─────────────────────────────────────────────────────────────

# ── IBM Quantum (required for REAL HARDWARE QRNG mode) ───────
# 1. Create a free account: https://quantum.cloud.ibm.com
# 2. Go to "API tokens" and generate a token.
IBM_QUANTUM_API_KEY=

# Optional: IBM Quantum Platform instance CRN. Leave empty to use
# your account's default instance.
IBM_QUANTUM_INSTANCE=

# IBM Quantum access channel. The current IBM Quantum Platform
# uses "ibm_quantum_platform".
IBM_QUANTUM_CHANNEL=ibm_quantum_platform

# Optional: pin a specific quantum backend (e.g. ibm_brisbane).
# Leave empty for AUTO = least-busy operational, non-simulator QPU.
IBM_QUANTUM_BACKEND=

# ── Lab limits ───────────────────────────────────────────────
QRNG_MIN_SHOTS=8
QRNG_MAX_SHOTS=4096
QRNG_DEFAULT_SHOTS=256
QRNG_JOB_TIMEOUT_SECONDS=900
# Local cooldown between hardware submissions (IBM allows 5/min).
QRNG_SUBMIT_COOLDOWN_SECONDS=13
PRNG_MAX_BITS=8192
PRNG_DEFAULT_BITS=256

# ── Storage ──────────────────────────────────────────────────
# Where experiment records are persisted (JSONL). Relative to the
# backend working directory.
QRLAB_DATA_DIR=./data
